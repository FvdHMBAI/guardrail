[17.662628, "o", "\r\n  \u001b[1mGuardRail\u001b[0m \u001b[2mv0.3.0\u001b[0m\r\n\r\n  \u001b[0;32m18\u001b[0m core guards active\r\n"]
[17.662692, "o", "  \u001b[0;32mEnforcement verified\u001b[0m (registered hook and deny probe)\r\n"]
[17.662969, "o", "  \u001b[2m0\u001b[0m pro guards \u001b[2m(guardrail upgrade --key ...)\u001b[0m\r\n\r\n  \u001b[2mAudit:\u001b[0m \u001b[1m3\u001b[0m blocked / 5 total\r\n\r\n  \u001b[2mRecent:\u001b[0m\r\n  \u001b[0;31mx\u001b[0m rm -rf /home/developer/project\r\n  \u001b[0;31mx\u001b[0m git push --force origin main\r\n"]
[17.663002, "o", "  \u001b[0;31mx\u001b[0m DELETE FROM profiles WHERE 1=1\r\n  \u001b[0;32m+\u001b[0m npm test\r\n  \u001b[0;32m+\u001b[0m git push origin feature/my-branch\r\n\r\n"]
