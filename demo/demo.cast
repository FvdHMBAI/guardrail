[1.03236, "o", "\r\n"]
[1.535189, "o", "\r\n  \u001b[1mGuardRail\u001b[0m \u001b[2mv0.3.1\u001b[0m\r\n  \u001b[2mPre-execution security for AI coding agents\u001b[0m\r\n\r\n"]
[1.938076, "o", "  \u001b[0;32m+\u001b[0m Installed \u001b[1m10\u001b[0m core guards\r\n"]
