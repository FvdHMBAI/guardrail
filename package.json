{
  "name": "guardrail-agent",
  "version": "0.4.0",
  "description": "Pre-execution security for AI coding agents. 22 guards that block dangerous commands before they run, on both Bash and file writes. Free 14-day Pro trial included.",
  "bin": {
    "guardrail": "./bin/guardrail.sh"
  },
  "scripts": {
    "typecheck": "bash -n bin/guardrail.sh install.sh dispatchers/*.sh lib/*.sh guards/core/*.sh",
    "test": "./tests/regression.sh && ./tests/adversarial.sh && ./tests/installer-adversarial.sh",
    "postinstall": "echo '\\n  Run: npx guardrail-agent init\\n'"
  },
  "keywords": [
    "ai-safety",
    "ai-agents",
    "claude-code",
    "guardrails",
    "security",
    "pre-execution",
    "eu-ai-act",
    "governance",
    "coding-agents"
  ],
  "author": "Prompt & Build",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/FvdHMBAI/guardrail.git"
  },
  "engines": {
    "node": ">=16.0.0"
  },
  "os": [
    "linux",
    "darwin"
  ],
  "files": [
    "bin/",
    "guards/core/",
    "guards/custom/",
    "dispatchers/",
    "lib/",
    "tests/",
    "guardrail.config.sh",
    "install.sh",
    "LICENSE",
    "README.md"
  ]
}
